{
  "name": "pet-escape-hotel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Screw & Rescue - a cute 3D screw puzzle (Three.js) for the web, CrazyGames, GameDistribution, GamePix, Playgama, GameMonetize and Y8",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "build:crazygames": "vite build --mode crazygames",
    "build:gd": "vite build --mode gd",
    "build:gamepix": "vite build --mode gamepix",
    "build:playgama": "vite build --mode playgama",
    "build:gamemonetize": "vite build --mode gamemonetize",
    "build:y8": "vite build --mode y8",
    "preview": "vite preview --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:gamemonetize": "playwright test -c playwright.gamemonetize.config.ts",
    "e2e:y8": "playwright test -c playwright.y8.config.ts",
    "art": "node scripts/render-art.mjs",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "audit": "tsx scripts/audit.ts",
    "levels": "tsx scripts/gen-levels.ts",
    "submission": "node scripts/submission.mjs zip",
    "submission:gd": "node scripts/submission.mjs gd",
    "submission:gamepix": "node scripts/submission.mjs gamepix",
    "submission:web": "npm run build:web && node scripts/web/zip.mjs",
    "submission:playgama": "npm run build:playgama && node scripts/playgama/zip.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:zips": "node scripts/check-zips.mjs",
    "check:web": "node scripts/web/check.mjs",
    "store:web": "node scripts/web/store.mjs",
    "check:playgama": "node scripts/playgama/check.mjs",
    "test:playgama": "node scripts/playgama/test.mjs",
    "qa:playgama": "node scripts/playgama/qa.mjs",
    "submission:gamemonetize": "npm run build:gamemonetize && node scripts/gamemonetize/zip.mjs",
    "check:gamemonetize": "node scripts/gamemonetize/check.mjs",
    "images:gamemonetize": "node scripts/gamemonetize/images.mjs",
    "submission:y8": "npm run build:y8 && node scripts/y8/zip.mjs",
    "check:y8": "node scripts/y8/check.mjs",
    "media:y8": "node scripts/y8/media.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
